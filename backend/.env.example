# Smart Healthcare Management System - Environment Variables

# Flask Secret Key
SECRET_KEY=super-secret-smart-healthcare-dev-key-2026

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-smart-healthcare-2026
JWT_EXPIRE_HOURS=24

# Database: MongoDB Atlas or local MongoDB
# For MongoDB Atlas, use: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# If left as default or unreachable, system automatically runs high-fidelity in-memory PyMongo mock.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=smart_healthcare_db

# AI Health Assistant (Optional - Leave blank for rule-based clinical education fallback)
AI_API_KEY=
AI_PROVIDER=gemini

# Application Environment
FLASK_ENV=development
